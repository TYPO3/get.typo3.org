styles.templates.layoutRootPath: 'EXT:{{ package.extensionKey }}/Resources/Private/Templates/Layouts/'
styles.templates.partialRootPath: 'EXT:{{ package.extensionKey }}/Resources/Private/Templates/Partials/'
styles.templates.templateRootPath: 'EXT:{{ package.extensionKey }}/Resources/Private/Templates/Content/'

page.pageview.paths: 'EXT:{{ package.extensionKey }}/Resources/Private/PageView/'

page.meta.viewport: 'width=device-width, initial-scale=1'
page.meta.robots: 'index,follow'
page.meta.apple-mobile-web-app-capable: 'no'
page.meta.compatible: 'IE=edge'

page.tracking.google.trackingID: ''
page.tracking.google.anonymizeIp: '1'

config.no_cache: '0'
config.removeDefaultJS: '0'
config.admPanel: '1'
config.prefixLocalAnchors: 'all'
config.headerComment: 'built by get.typo3.org/sitepackage'
config.sendCacheHeaders: '1'
