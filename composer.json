{
	"name": "t3o/get.typo3.org",
	"description": "TYPO3 Download Site 'get.typo3.org'",
	"license": "GPL-2.0-or-later",
	"type": "project",
	"keywords": [
		"TYPO3 CMS",
		"download"
	],
	"readme": "README.md",
	"authors": [
		{
			"name": "Benni Mack",
			"email": "benni@typo3.org"
		},
		{
			"name": "Simon Gilli",
			"email": "simon.gilli@typo3.org"
		},
		{
			"name": "Susanne Moog",
			"email": "susanne.moog@typo3.com"
		},
		{
			"name": "Benjamin Kott",
			"email": "benjamin.kott@typo3.com"
		}
	],
	"homepage": "https://get.typo3.org",
	"support": {
		"issues": "https://github.com/TYPO3/get.typo3.org/issues",
		"chat": "https://typo3.slack.com/archives/C779C18G5",
		"source": "https://github.com/TYPO3/get.typo3.org"
	},
	"require": {
		"php": "^8.4",
		"ext-SimpleXML": "*",
		"ext-ctype": "*",
		"ext-iconv": "*",
		"ext-json": "*",
		"ext-mbstring": "*",
		"ext-sqlite3": "*",
		"ext-zip": "*",
		"ext-zlib": "*",
		"composer/semver": "^3.3",
		"doctrine/collections": "^2.0",
		"doctrine/dbal": "^3.7",
		"doctrine/doctrine-bundle": "^2.14",
		"doctrine/doctrine-migrations-bundle": "^3.2",
		"doctrine/inflector": "^2.0",
		"doctrine/orm": "^3.0",
		"doctrine/persistence": "^3.1",
		"easycorp/easyadmin-bundle": "^4.3",
		"guzzlehttp/guzzle": "^7.10",
		"guzzlehttp/promises": "^2.3.0",
		"knplabs/knp-menu": "^3.3",
		"nelmio/api-doc-bundle": "^4.9",
		"nelmio/cors-bundle": "^2.2",
		"nelmio/security-bundle": "^3.0",
		"psr/log": "^2.0",
		"symfony/asset": "^7.4",
		"symfony/cache": "^7.4",
		"symfony/cache-contracts": "^3.0",
		"symfony/console": "^7.4",
		"symfony/dependency-injection": "^7.4",
		"symfony/dotenv": "^7.4",
		"symfony/expression-language": "^7.4",
		"symfony/finder": "^7.4",
		"symfony/flex": "^2.2",
		"symfony/form": "^7.4",
		"symfony/framework-bundle": "^7.4",
		"symfony/http-client": "^7.4",
		"symfony/http-foundation": "^7.4",
		"symfony/http-kernel": "^7.4",
		"symfony/intl": "^7.4",
		"symfony/mailer": "^7.4",
		"symfony/mime": "^7.4",
		"symfony/monolog-bundle": "^3.1",
		"symfony/notifier": "^7.4",
		"symfony/process": "^7.4",
		"symfony/property-access": "^7.4",
		"symfony/property-info": "^7.4",
		"symfony/routing": "^7.4",
		"symfony/runtime": "^7.4",
		"symfony/security-bundle": "^7.4",
		"symfony/security-http": "^7.4",
		"symfony/serializer": "^7.4",
		"symfony/translation": "^7.4",
		"symfony/twig-bundle": "^7.4",
		"symfony/validator": "^7.4",
		"symfony/web-link": "^7.4",
		"symfony/yaml": "^7.4",
		"t3g/symfony-template-bundle": "dev-master",
		"t3g/symfony-usercentrics-bundle": "^2.0 || dev-master",
		"twig/extra-bundle": "^3.0",
		"twig/twig": "^3.0"
	},
	"require-dev": {
		"bamarni/composer-bin-plugin": "^1.8",
		"doctrine/doctrine-fixtures-bundle": "^3.4",
		"fakerphp/faker": "^1.20",
		"symfony/browser-kit": "^7.4",
		"symfony/css-selector": "^7.4",
		"symfony/debug-bundle": "^7.4",
		"symfony/maker-bundle": "^1.45",
		"symfony/panther": "^2.0",
		"symfony/stopwatch": "^7.4",
		"symfony/var-dumper": "^7.4",
		"symfony/web-profiler-bundle": "^7.4"
	},
	"replace": {
		"paragonie/random_compat": "2.*",
		"symfony/polyfill-ctype": "*",
		"symfony/polyfill-iconv": "*",
		"symfony/polyfill-intl-grapheme": "*",
		"symfony/polyfill-intl-icu": "*",
		"symfony/polyfill-intl-idn": "*",
		"symfony/polyfill-intl-normalizer": "*",
		"symfony/polyfill-mbstring": "*",
		"symfony/polyfill-php56": "*",
		"symfony/polyfill-php70": "*",
		"symfony/polyfill-php71": "*",
		"symfony/polyfill-php72": "*",
		"symfony/polyfill-php73": "*",
		"symfony/polyfill-php74": "*",
		"symfony/polyfill-php80": "*",
		"symfony/polyfill-php81": "*"
	},
	"conflict": {
		"symfony/symfony": "*"
	},
	"prefer-stable": true,
	"autoload": {
		"classmap": ["config/"],
		"psr-4": {
			"App\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"App\\Tests\\": "tests"
		}
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true,
			"symfony/flex": true,
			"symfony/runtime": true
		},
		"optimize-autoloader": true,
		"preferred-install": {
			"t3g/*": "source",
			"zircote/swagger-php": "source",
			"*": "dist"
		},
		"sort-packages": true,
		"platform": {
			"php": "8.4.6"
		}
	},
	"extra": {
		"runtime": {
			"use_putenv": true
		},
		"bamarni-bin": {
			"bin-links": true,
			"forward-command": false,
			"target-directory": "tools"
		},
		"symfony": {
			"allow-contrib": false,
			"id": "01C8T4G8QYJT0T9Q9SWDHVW8AC",
			"require": "^7.4"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"@auto-scripts",
			"@satis:install",
			"@tools:setup:install"
		],
		"post-update-cmd": [
			"@auto-scripts",
			"@satis:update",
			"@tools:setup:update"
		],
		"auto-scripts": {
			"cache:clear --no-optional-warmers": "symfony-cmd",
			"assets:install %PUBLIC_DIR%": "symfony-cmd"
		},
		"bin": "echo 'bin not installed.'",
		"ci": [
			"@ci:static",
			"@ci:dynamic"
		],
		"ci:dynamic": [
			"@ci:tests"
		],
		"ci:json:lint": "@php jsonlint -q composer.json",
		"ci:php": [
			"@ci:php:lint",
			"@ci:php:cs-fixer",
			"@ci:php:stan"
		],
		"ci:php:cs-fixer": "@php php-cs-fixer fix -v --dry-run --diff",
		"ci:php:lint": "@php phplint --no-progress",
		"ci:php:stan": "@php phpstan analyse --no-progress",
		"ci:static": [
			"@ci:json:lint",
			"@ci:yaml:lint",
			"@ci:php"
		],
		"ci:tests": [
			"@ci:tests:php"
		],
		"ci:tests:php": [
			"@ci:tests:php:unit",
			"@ci:tests:php:functional"
		],
		"ci:tests:php:functional": "@php phpunit -c tests/Functional/phpunit.xml",
		"ci:tests:php:unit": "@php phpunit -c tests/Unit/phpunit.xml",
		"ci:yaml:lint": "@php yaml-lint .ddev config",
		"fix": [
			"@fix:php"
		],
		"fix:php": [
			"@fix:php:cs-fixer"
		],
		"update:phpstan-baseline": [
			"@php phpstan analyse --generate-baseline"
		],
		"fix:php:cs-fixer": "@php php-cs-fixer fix",
		"satis:install": [
			"rm -fr satis",
			"@composer create-project --stability=dev --ansi composer/satis:^3.0 satis"
		],
		"satis:update": [
			"@satis:install"
		],
		"tools:setup:clean": "rm -r tools/**/composer.lock tools/**/vendor",
		"tools:setup:install": "@composer bin all install --ansi",
		"tools:setup:update": "@composer bin all update --ansi"
	},
	"scripts-descriptions": {
		"tools:setup:install": "Install development tools.",
		"tools:setup:update": "Update development tools."
	}
}
